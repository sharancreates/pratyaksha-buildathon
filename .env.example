# PRATYAKSHA — Environment Configuration Template
# Never commit real secrets or service account JSON keys.

# Server runtime
PORT=3000
NODE_ENV=development

# Google Earth Engine (optional — if omitted, deterministic DEMO MODE activates automatically)
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=
GEE_PROJECT_ID=

# Python FastAPI & PostgreSQL / PostGIS (for local Python backend deployment)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pratyaksha
POSTGRES_USER=pratyaksha_user
POSTGRES_PASSWORD=change_me_locally
CORS_ORIGINS=http://localhost:3000

# ML Segmentation weights path (optional — falls back to deterministic spectral demo when absent)
UNET_WEIGHTS_PATH=./backend/models/environmental_unet_v1.pt
