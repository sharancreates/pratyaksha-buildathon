# Template for Google Secret Manager: DATABASE_URL
# Option A: Unix Domain Socket connection for Cloud Run
# Format: postgresql://<USER>:<PASSWORD>@/<DATABASE>?host=/cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE_NAME>
DATABASE_URL=postgresql://pratyaksha_app:REPLACE_WITH_STRONG_PASSWORD@/pratyaksha?host=/cloudsql/REPLACE_WITH_PROJECT_ID:asia-south1:pratyaksha-db

# Option B: Private IP connection across Serverless VPC Access
# Format: postgresql://<USER>:<PASSWORD>@<PRIVATE_IP>:5432/<DATABASE>
# DATABASE_URL=postgresql://pratyaksha_app:REPLACE_WITH_STRONG_PASSWORD@10.0.0.3:5432/pratyaksha
